;; Forms for TestJokerClosures: each printed, or its error, on the
;; bytecode VM and compiled to closures -- the same bytes required.
(defn fib [n] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(prn (fib 20))
(prn (loop [i 0 acc []] (if (< i 5) (recur (inc i) (conj acc (* i i))) acc)))
(defn count-down [n] (when (pos? n) (recur (dec n))))
(prn (count-down 100000))
(prn (letfn [(ev? [n] (if (zero? n) true (od? (dec n)))) (od? [n] (if (zero? n) false (ev? (dec n))))] [(ev? 10) (od? 7)]))
(prn ((fn f [& xs] (if (seq xs) (+ (first xs) (apply f (rest xs))) 0)) 1 2 3 4))
(prn (let [fs (for [i (range 3)] (fn [] i))] (map #(%) fs)))
(prn (let [x 1 f (fn [] x) x 2] [x (f)]))
(prn (try (/ 1 0) (catch Error e (str "caught: " (ex-message e))) (finally (println "finally ran"))))
(prn (try (throw (ex-info "boom" {:a 1})) (catch ExInfo e [(ex-message e) (ex-data e)])))
(prn (try (try (throw (ex-info "inner" {})) (finally (println "inner finally"))) (catch Error e (ex-message e))))
(prn (try (nth [1 2] 5) (catch Error e :out-of-range)))
(defmacro unless [c & body] `(if ~c nil (do ~@body)))
(prn (unless false :yes) (unless true :no))
(prn (macroexpand '(unless x y)))
(defmulti area :shape)
(defmethod area :square [{:keys [s]}] (* s s))
(defmethod area :default [_] :unknown)
(prn (map area [{:shape :square :s 3} {:shape :circle}]))
(prn (let [{:keys [a b] :or {b 5}} {:a 1} [x & more] [1 2 3]] [a b x more]))
(prn (take 5 (iterate #(* 2 %) 1)) (take 3 (lazy-seq (cons 1 (lazy-seq [2 3 4])))))
(def a (atom 0))
(dotimes [i 10] (swap! a + i))
(prn @a)
(prn (persistent! (reduce conj! (transient []) (range 5))))
(prn {:a 1 :b [1 2 {:c #{1 2}}]} #{:x} (meta ^{:m 1} [1]))
(prn (reduce + (map inc (filter odd? (range 1000)))))
(prn (sort-by - [3 1 2]) (group-by even? (range 6)) (frequencies "abracadabra"))
(prn (apply str (interpose "," ["a" "b"])) (format "%05d" 42))
(prn (case 2 1 :one 2 :two :other) (cond-> 1 true inc false (* 10)))
(prn (with-out-str (print "hi")))
(def ^:dynamic *d* 1)
(prn (binding [*d* 2] *d*) *d*)
(defn arity ([] 0) ([a] 1) ([a b] 2) ([a b & c] (+ 2 (count c))))
(prn (map #(apply arity %) [[] [1] [1 2] [1 2 3 4]]))
(prn (try (arity) (arity 1 2 3) (catch Error e (ex-message e))))
(prn ((fn [] (fib 2) (fib 3))))
(+ 1 "a")
(inc nil)
(undefined-thing 1)
((fn [x] x))
(nil 1)
(prn (str "still here " (fib 10)))
