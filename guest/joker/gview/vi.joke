;; gview.vi -- a modal editor in the box (doc/LISP-SANDBOX.md, *The editor
;; on the console*): vim's keys over a view of the program's graph, the
;; view a buffer of the editing server (the namespace ed, view-serve's
;; requests), the keys and the screen the console's (the namespace term).
;;
;; (gview.vi/edit "def ml_find_line") opens the view and edits it until :q.
;; The text is edited here; at the end of each command that changed it --
;; x, dd, p, a visual d, an insert left by Esc -- the change that turns
;; the server's text into this one is sent, with the cursor, and the
;; server's answer is what the buffer shows next: applied (the graph
;; changed, and the view printed again), pending (not yet a program, the
;; reason on the status line), layout or same.
;;
;; Normal mode, a count before most: h j k l and the arrows, 0 $ w b gg G,
;; x dd yy p P (the unnamed register, or "a ... a named one), i a A I o O,
;; v V (visual: a motion, then d x or y), /PATTERN n N, u (the session's
;; undo), Enter (the view at the cursor: what the node there is about), K
;; (its callers), Ctrl-O (back where Enter or K came from).  Command line:
;; :q, :w NAME (the C into the store, ref NAME), :e VIEW ARG, :rename NAME
;; (the entity at the cursor, every declaration and use), :undo, :back, and
;; :(FORM) -- Joker, its value on the status line: the REPL as the command
;; line.  Lines wider than the screen scroll sideways with the cursor.
(ns gview.vi
  (:require [joker.string :as s]))

(defn- starts
  "The offsets lines start at."
  [t]
  (loop [i 0 acc [0]]
    (let [j (s/index-of t "\n" i)]
      (if (and j (< (inc j) (count t)))
        (recur (inc j) (conj acc (inc j)))
        acc))))

(defn- row-of [ss off]
  (loop [r (dec (count ss))]
    (if (and (pos? r) (> (nth ss r) off)) (recur (dec r)) r)))

(defn- line-end
  "Where row ends: its newline, or the text's end."
  [t ss r]
  (if (< (inc r) (count ss)) (dec (nth ss (inc r))) (count t)))

(defn- line-span
  "Rows r to r+n-1 as [from to], the last newline included."
  [t r n]
  (let [ss (starts t)
        r2 (min (dec (count ss)) (+ r n -1))]
    [(nth ss r) (if (< (inc r2) (count ss)) (nth ss (inc r2)) (count t))]))

(defn- pos
  "The cursor as [row col]."
  [{:keys [text off]}]
  (let [ss (starts text) r (row-of ss off)] [r (- off (nth ss r))]))

(defn- at
  "The offset of [r c] in t, c held to the line (its last character in
  normal mode)."
  [t r c insert?]
  (let [ss (starts t)
        r (max 0 (min r (dec (count ss))))
        b (nth ss r)
        e (line-end t ss r)
        last (if insert? e (max b (dec e)))]
    (max b (min (+ b c) last))))

(defn- move [st r c] (assoc st :off (at (:text st) r c (= (:mode st) :insert))))

(defn- clamp [st] (assoc st :off (max 0 (min (:off st) (max 0 (dec (count (:text st))))))))

(defn- answer
  "The server's answer made the buffer: its text, the cursor at the
  offset its header gives (or held), the header on the status line."
  [st {:keys [head body]} cursor?]
  (let [ws (s/split head #" ")
        off (if (and cursor? (> (count ws) 1)) (read-string (second ws)) (:off st))]
    (clamp (assoc st :text body :server body :msg head :off off))))

(defn- ask
  "A request to the server; an error on the status line, the buffer as the
  server has it."
  [st req cursor?]
  (try (answer st (ed/req req) cursor?)
       (catch Error e (clamp (assoc st :text (:server st) :msg (str "error: " (ex-message e)))))))

(defn- sync
  "The edit sent: the change from the server's text to the buffer's, the
  cursor with it."
  [st]
  (let [a (:server st) b (:text st)]
    (if (= a b)
      st
      (let [n (min (count a) (count b))
            p (loop [i 0] (if (and (< i n) (= (nth a i) (nth b i))) (recur (inc i)) i))
            q (loop [i 0] (if (and (< i (- n p)) (= (nth a (- (count a) 1 i)) (nth b (- (count b) 1 i))))
                            (recur (inc i)) i))]
        (ask st (str "change " p " " (- (count a) q) " " (pr-str (subs b p (- (count b) q)))
                     " " (min (:off st) (count b)))
             true)))))

(defn- cut
  "Text from..to taken out into the register the command named (the
  unnamed one with it), line-wise or not."
  [st from to lines?]
  (let [t (:text st) x {:text (subs t from to) :lines lines?}]
    (-> st
        (assoc :text (str (subs t 0 from) (subs t to)) :off from)
        (assoc-in [:regs "\""] x)
        (assoc-in [:regs (:reg st "\"")] x)
        clamp)))

(defn- yank [st from to lines?]
  (let [x {:text (subs (:text st) from to) :lines lines?}]
    (-> st (assoc-in [:regs "\""] x) (assoc-in [:regs (:reg st "\"")] x)
        (assoc :msg (str (count (:text x)) " characters yanked")))))

(defn- put
  "The register put after the cursor (before?: before it); a line-wise one
  below the line (above it)."
  [st before? n]
  (let [{rt :text lines? :lines} (get (:regs st) (:reg st "\""))
        t (:text st)
        [r _] (pos st)
        x (apply str (repeat n rt))]
    (cond
      (nil? rt) (assoc st :msg "nothing in the register")
      lines? (let [[b e] (line-span t r 1)
                   o (if before? b e)
                   x (if (or (= o (count t)) (s/ends-with? x "\n")) x (str x "\n"))
                   x (if (and (= o (count t)) (not (s/ends-with? t "\n"))) (str "\n" x) x)]
               (assoc st :text (str (subs t 0 o) x (subs t o)) :off (if (= o (count t)) (inc o) o)))
      :else (let [o (if (or before? (empty? t)) (:off st) (min (count t) (inc (:off st))))]
              (assoc st :text (str (subs t 0 o) x (subs t o)) :off (+ o (dec (count x))))))))

(defn- insert-text [st x]
  (let [{:keys [text off]} st]
    (assoc st :text (str (subs text 0 off) x (subs text off)) :off (+ off (count x)))))

(defn- word-char? [c] (boolean (re-matches #"[A-Za-z0-9_]" (str c))))

(defn- word-forward [t off]
  (let [n (count t)
        w? (and (< off n) (word-char? (nth t off)))
        i (loop [i off] (if (and (< i n) (= w? (boolean (word-char? (nth t i)))) (not= (nth t i) \space)) (recur (inc i)) i))]
    (loop [i i] (if (and (< i n) (#{\space \newline} (nth t i))) (recur (inc i)) (min i (max 0 (dec n)))))))

(defn- word-back [t off]
  (let [i (loop [i (dec off)] (if (and (pos? i) (#{\space \newline} (nth t i))) (recur (dec i)) i))
        w? (and (>= i 0) (word-char? (nth t i)))]
    (max 0 (loop [i i] (if (and (pos? i) (= w? (boolean (word-char? (nth t (dec i))))) (not (#{\space \newline} (nth t (dec i))))) (recur (dec i)) i)))))

(defn- search
  "The cursor at the next match of the pattern after it (back?: before
  it), round the end."
  [st back?]
  (let [p (:pattern st) t (:text st) o (:off st)]
    (if (empty? p)
      (assoc st :msg "no pattern")
      (let [hit (if back?
                  (or (when (pos? o) (s/last-index-of (subs t 0 o) p)) (s/last-index-of t p))
                  (or (s/index-of t p (inc o)) (s/index-of t p)))]
        (if hit
          (assoc st :off hit :msg (str "/" p))
          (assoc st :msg (str "not found: " p)))))))

(defn- jump
  "The buffer reopened on what the node at the cursor is about (as: the
  view to open there), the place it left kept for Ctrl-O."
  [st as]
  (let [here {:view (:view st) :off (:off st)}
        st2 (ask st (str "at " (:off st) (when as (str " " as))) false)
        [id] (s/split (:msg st2 "") #" ")]
    (if (s/starts-with? (or id "") "#")
      (-> st2 (update :history (fnil conj []) here)
          (assoc :view (str (or as (first (s/split (:view st) #" "))) " " id) :off 0))
      st2)))

(defn- reopen
  "The editor's own buffer put on another view."
  [st view]
  (ask st (str "@" (:buf st) " open " view) false))

(defn- back [st]
  (if-let [h (peek (:history st))]
    (-> (reopen st (:view h))
        (assoc :view (:view h) :off (:off h) :history (pop (:history st)))
        clamp)
    (assoc st :msg "no older place")))

(defn- command
  "A command line's command."
  [st line]
  (let [[c arg] (s/split (s/trim line) #" " 2)]
    (cond
      (s/starts-with? line "(") (assoc st :msg (try (pr-str (eval (read-string line)))
                                                    (catch Error e (str "error: " (ex-message e)))))
      (= c "q") (assoc st :quit true)
      (= c "w") (assoc st :msg (try (str "written: " (:head (ed/req (str "write " (or arg "edited")))) " bytes")
                                    (catch Error e (str "error: " (ex-message e)))))
      (= c "e") (assoc (reopen st arg) :off 0 :view arg)
      (= c "rename") (ask st (str "rename " (:off st) " " arg) false)
      (= c "undo") (ask st "undo" false)
      (= c "back") (back st)
      :else (assoc st :msg (str "not a command: " c)))))

(defn- times [n f st] (loop [i 0 st st] (if (< i n) (recur (inc i) (f st)) st)))

(defn- motion
  "A motion key's cursor, n times; nil when k is none."
  [st k n]
  (let [[r c] (pos st) t (:text st)]
    (case k
      ("h" "<left>") (move st r (- c n))
      ("l" "<right>") (move st r (+ c n))
      ("j" "<down>") (move st (+ r n) c)
      ("k" "<up>") (move st (- r n) c)
      "0" (move st r 0)
      "$" (move st r 100000)
      "w" (times n #(assoc % :off (word-forward t (:off %))) st)
      "b" (times n #(assoc % :off (word-back t (:off %))) st)
      "G" (move st (if (:count st) (dec n) 100000) 0)
      "n" (times n #(search % false) st)
      "N" (times n #(search % true) st)
      nil)))

(defn- word-end
  "The end of the word (or the run of other characters) at off: the
  offset after it."
  [t off]
  (let [n (count t)
        w? (and (< off n) (word-char? (nth t off)))]
    (loop [i off] (if (and (< i n) (= w? (boolean (word-char? (nth t i)))) (not (#{\space \newline} (nth t i)))) (recur (inc i)) i))))

(defn- object
  "The span [from to] of text object k (w, parens, quotes) round off, the
  delimiters and spaces with it when around?; nil when there is none."
  [t off k around?]
  (let [n (count t)]
    (case k
      "w" (if (and (< off n) (= (nth t off) \space))
            (let [b (loop [i off] (if (and (pos? i) (= (nth t (dec i)) \space)) (recur (dec i)) i))
                  e (loop [i off] (if (and (< i n) (= (nth t i) \space)) (recur (inc i)) i))]
              [b (if around? (word-end t e) e)])
          (let [w? (and (< off n) (word-char? (nth t off)))
                b (loop [i off] (if (and (pos? i) (= w? (boolean (word-char? (nth t (dec i))))) (not (#{\space \newline} (nth t (dec i))))) (recur (dec i)) i))
                e (word-end t off)
                e2 (if around? (loop [i e] (if (and (< i n) (= (nth t i) \space)) (recur (inc i)) i)) e)]
            (when (< b e) [b e2])))
      ("(" ")" "b") (let [open (loop [i off d 0]
                                 (cond (neg? i) nil
                                       (and (= (nth t i) \() (zero? d)) i
                                       (= (nth t i) \() (recur (dec i) (dec d))
                                       (and (= (nth t i) \)) (not= i off)) (recur (dec i) (inc d))
                                       :else (recur (dec i) d)))
                          close (when open
                                  (loop [i (inc open) d 0]
                                    (cond (>= i n) nil
                                          (and (= (nth t i) \)) (zero? d)) i
                                          (= (nth t i) \)) (recur (inc i) (dec d))
                                          (= (nth t i) \() (recur (inc i) (inc d))
                                          :else (recur (inc i) d))))]
                      (when close (if around? [open (inc close)] [(inc open) close])))
      "\"" (let [b (s/last-index-of (subs t 0 (inc (min off (dec n)))) "\"")
                 b (if (and b (= b off)) (or (s/last-index-of (subs t 0 off) "\"") b) b)
                 e (when b (s/index-of t "\"" (inc b)))]
             (when (and b e) (if around? [b (inc e)] [(inc b) e])))
      nil)))

(defn- operate
  "Operator op (d c y) on [from to]: cut, cut and insert, or yank."
  [st op from to lines?]
  (case op
    "d" (cut st from to lines?)
    "c" (assoc (cut st from to lines?) :mode :insert :off from)
    "y" (assoc (yank st from to lines?) :off from)))

(defn- normal [st k]
  (let [[r c] (pos st)
        t (:text st)
        n (or (:count st) 1)
        pend (:pend st)
        st (dissoc st :pend)
        done #(dissoc % :count :reg :obj)]
    (cond
      (and (re-matches #"[1-9]" k) (not (#{"\"" "m" "'" "`" "r"} pend)) (not (:obj st))) (assoc st :pend pend :count (+ (* 10 (or (:count st) 0)) (read-string k)))
      (and (= k "0") (:count st) (not (#{"\"" "m" "'" "`" "r"} pend))) (assoc st :pend pend :count (* 10 (:count st)))
      (= pend "\"") (assoc st :reg k)
      (= pend "g") (done (if (= k "g") (move st (if (:count st) (dec n) 0) 0) st))
      (= pend "m") (done (assoc-in st [:marks k] (:off st)))
      (= pend "r") (done (let [e (+ (:off st) n)]
                           (if (and (<= e (line-end t (starts t) r)) (= (count k) 1))
                             (assoc st :text (str (subs t 0 (:off st)) (apply str (repeat n k)) (subs t e)) :off (dec e))
                             st)))
      (#{"'" "`"} pend) (done (if-let [o (get (:marks st) k)]
                                (let [st (clamp (assoc st :off o))]
                                  (if (= pend "'") (let [[r2] (pos st)] (move st r2 0)) st))
                                (assoc st :msg (str "no mark " k))))
      (#{"d" "c" "y"} pend)
      (cond
        (= k pend) (done (let [[b e] (line-span t r n)
                               e (if (and (= pend "c") (> e b) (= (nth t (dec e)) \newline)) (dec e) e)]
                           (operate st pend b e (not= pend "c"))))
        (#{"i" "a"} k) (assoc st :pend pend :obj k)
        (:obj st) (done (if-let [[b e] (object t (:off st) k (= (:obj st) "a"))]
                          (operate st pend b e false)
                          (assoc st :msg (str "no object " (:obj st) k))))
        (and (= pend "c") (= k "w")) (done (operate st pend (:off st) (word-end t (:off st)) false))
        :else (done (if-let [m (motion st k n)]
                      (let [a (:off st) z (:off m)
                            [from to] (if (< z a) [z a] [a z])
                            to (if (#{"$" "l" "<right>"} k) (min (line-end t (starts t) r) (max to (inc a))) to)]
                        (if (#{"j" "k" "<down>" "<up>" "G"} k)
                          (let [ss (starts t) r1 (row-of ss from) r2 (row-of ss to)
                                [b e] (line-span t r1 (inc (- r2 r1)))]
                            (operate st pend b e true))
                          (operate st pend from to false)))
                      st)))
      :else
      (if-let [m (motion st k n)]
        (done m)
        (case k
          ("g" "d" "c" "y" "\"" "m" "'" "`" "r") (assoc st :pend k)
          "x" (done (let [e (min (line-end t (starts t) r) (+ (:off st) n))]
                      (if (< (:off st) e) (cut st (:off st) e false) st)))
          "s" (done (let [e (min (line-end t (starts t) r) (+ (:off st) n))] (operate st "c" (:off st) e false)))
          "D" (done (cut st (:off st) (line-end t (starts t) r) false))
          "C" (done (operate st "c" (:off st) (line-end t (starts t) r) false))
          "S" (done (let [[b e] (line-span t r n) e (if (and (> e b) (= (nth t (dec e)) \newline)) (dec e) e)] (operate st "c" b e false)))
          "p" (done (put st false n))
          "P" (done (put st true n))
          "i" (done (assoc st :mode :insert))
          "a" (done (let [st (assoc st :mode :insert)]
                      (if (and (< (:off st) (count t)) (not= (nth t (:off st)) \newline)) (update st :off inc) st)))
          "A" (done (move (assoc st :mode :insert) r 100000))
          "I" (done (let [st (move (assoc st :mode :insert) r 0) o (:off st)]
                      (assoc st :off (loop [i o] (if (and (< i (count t)) (= (nth t i) \space)) (recur (inc i)) i)))))
          "o" (done (insert-text (move (assoc st :mode :insert) r 100000) "\n"))
          "O" (done (-> (move (assoc st :mode :insert) r 0) (insert-text "\n") (update :off dec)))
          "v" (done (assoc st :mode :visual :anchor (:off st) :linewise false))
          "V" (done (assoc st :mode :visual :anchor (:off st) :linewise true))
          "u" (done (ask st "undo" false))
          ("\r" "\n") (done (jump st nil))
          "K" (done (jump st "callers"))
          "\u000f" (done (back st))
          "/" (done (assoc st :mode :search :cmd ""))
          ":" (done (assoc st :mode :cmd :cmd ""))
          (done st))))))

(defn- visual [st k]
  (let [t (:text st)
        a (min (:anchor st) (:off st))
        z (max (:anchor st) (:off st))
        span (if (:linewise st)
               (let [ss (starts t) r1 (row-of ss a) r2 (row-of ss z)] (line-span t r1 (inc (- r2 r1))))
               [a (min (count t) (inc z))])
        leave #(dissoc (assoc % :mode :normal) :anchor :linewise :count)]
    (if-let [m (motion st k (or (:count st) 1))]
      (dissoc m :count)
      (case k
        ("d" "x") (leave (cut st (first span) (second span) (:linewise st)))
        "y" (leave (assoc (yank st (first span) (second span) (:linewise st)) :off a))
        "<esc>" (leave st)
        ("1" "2" "3" "4" "5" "6" "7" "8" "9") (assoc st :count (+ (* 10 (or (:count st) 0)) (read-string k)))
        st))))

(defn- insert [st k]
  (let [t (:text st) o (:off st)]
    (case k
      "<esc>" (let [st (assoc st :mode :normal) [r c] (pos st)] (move st r (dec c)))
      ("\u007f" "\b") (if (pos? o) (assoc st :text (str (subs t 0 (dec o)) (subs t o)) :off (dec o)) st)
      ("\r" "\n") (insert-text st "\n")
      ("<up>" "<down>" "<left>" "<right>") st
      (insert-text st k))))

(defn- line-input
  "A key typed on the command line or the search line: done runs it."
  [st k done]
  (case k
    "<esc>" (assoc st :mode :normal :cmd nil)
    ("\r" "\n") (done (assoc st :mode :normal :cmd nil) (:cmd st))
    ("\u007f" "\b") (if (empty? (:cmd st)) (assoc st :mode :normal :cmd nil) (update st :cmd #(subs % 0 (dec (count %)))))
    (update st :cmd str k)))

(defn- idle?
  "Normal mode with no command begun: where a command starts, and ends."
  [st]
  (and (= (:mode st) :normal) (nil? (:pend st)) (nil? (:count st)) (nil? (:reg st)) (nil? (:obj st))))

(defn- shift-marks
  "The marks moved with an edit from text a to text b: one after the change
  by its length, one inside it to its start."
  [st a b]
  (if (or (= a b) (empty? (:marks st)))
    st
    (let [n (min (count a) (count b))
          p (loop [i 0] (if (and (< i n) (= (nth a i) (nth b i))) (recur (inc i)) i))
          q (loop [i 0] (if (and (< i (- n p)) (= (nth a (- (count a) 1 i)) (nth b (- (count b) 1 i))))
                          (recur (inc i)) i))
          end (- (count a) q)
          d (- (count b) (count a))]
      (assoc st :marks (into {} (map (fn [[k o]] [k (cond (>= o end) (+ o d) (> o p) p :else o)]) (:marks st)))))))

(defn- step1
  "A key's effect on the editor's state.  A command that leaves normal
  mode with the text changed sends the change; the marks follow every
  change, the server's printing again included."
  [st k]
  (let [st2 (case (:mode st)
              :insert (insert st k)
              :visual (visual st k)
              :cmd (line-input st k command)
              :search (line-input st k (fn [st p] (search (assoc st :pattern p) false)))
              (normal st k))
        st2 (shift-marks st2 (:text st) (:text st2))]
    (if (and (idle? st2) (not= (:text st2) (:server st2)))
      (let [s (sync st2)] (shift-marks s (:text st2) (:text s)))
      st2)))

(defn step
  "A key's effect on the editor's state, the keys of each command that
  changed the text kept, for . to type again (n times, its count)."
  [st k]
  (if (and (= k ".") (= (:mode st) :normal) (nil? (:pend st)))
    (let [keys (:last st)
          ;; a count given replaces the change's own, as vim's does
          keys (if (:count st)
                 (concat (map str (str (:count st))) (drop-while #(re-matches #"[0-9]" %) keys))
                 keys)]
      (if (empty? keys)
        (dissoc st :count)
        (assoc (reduce step1 (dissoc st :count) keys) :last (:last st))))
    (let [begin? (idle? st)
          rec (if begin? [k] (conj (:rec st []) k))
          from (if begin? (:text st) (:rec-from st))
          st2 (step1 st k)]
      (if (idle? st2)
        (let [changed? (not= from (:text st2))
              repeatable? (not (#{"u" ":" "/" "\r" "\n" "K" "\u000f"} (first (drop-while #(re-matches #"[0-9\"]" %) rec))))]
          (-> st2 (dissoc :rec :rec-from)
              (assoc :last (if (and changed? repeatable?) rec (:last st2)))))
        (assoc st2 :rec rec :rec-from from)))))

(defn- render [st]
  (let [[rows cols] (term/size)
        [r c] (pos st)
        h (dec rows)
        top (let [t (:top st 0)] (cond (< r t) r (>= r (+ t h)) (inc (- r h)) :else t))
        left (let [l (:left st 0)] (cond (< c l) c (>= c (+ l cols)) (inc (- c cols)) :else l))
        ls (s/split (:text st) #"\n")
        ss (starts (:text st))
        [va vz] (when (= (:mode st) :visual)
                  (let [a (min (:anchor st) (:off st)) z (max (:anchor st) (:off st))]
                    (if (:linewise st)
                      (let [r1 (row-of ss a) r2 (row-of ss z)] [(nth ss r1) (line-end (:text st) ss r2)])
                      [a z])))
        line (fn [i l]
               (let [b (+ (get ss (+ top i) 0) left)
                     l (if (> (count l) left) (subs l left) "")
                     l (if (> (count l) cols) (subs l 0 cols) l)]
                 (if va
                   (apply str (map-indexed (fn [j ch] (if (<= va (+ b j) vz) (str "\u001b[7m" ch "\u001b[0m") (str ch))) l))
                   l)))
        shown (take h (drop top ls))
        status (case (:mode st)
                 :cmd (str ":" (:cmd st))
                 :search (str "/" (:cmd st))
                 :insert (str "-- INSERT -- " (:msg st))
                 :visual (str (if (:linewise st) "-- VISUAL LINE -- " "-- VISUAL -- ") (:msg st))
                 (str (:view st) "  " (:msg st)))
        status (if (> (count status) cols) (subs status 0 cols) status)]
    (term/write (str "\u001b[H\u001b[2J"
                     (s/join "\r\n" (map-indexed line shown))
                     (apply str (repeat (- h (count shown)) "\r\n~"))
                     "\r\n\u001b[7m" status "\u001b[0m"
                     "\u001b[" (inc (- r top)) ";" (inc (- c left)) "H"))
    (assoc st :top top :left left)))

(defn edit
  "The view VIEW (as view-serve's open takes it: \"def F\", \"callers
  F\") edited on the console until :q, or the input's end; the editor's
  last state."
  [view]
  (let [st (ask {:mode :normal :off 0 :view view :msg "" :regs {}} (str "open " view) false)
        st (assoc st :buf (second (s/split (:msg st) #" ")))]
    (term/start)
    (try
      (loop [st (render (assoc st :off 0))]
        (let [k (term/key)]
          (if (nil? k)
            st
            (let [st (step st k)]
              (if (:quit st) st (recur (render st)))))))
      (finally (term/write "\u001b[H\u001b[2J") (term/stop)))))
