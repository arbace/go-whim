(define (charwise_block_prep ed start.in end.in bdp lnum inclusive)
  (let* ([mem (ed-mem ed)] [fr (frame-push! ed 48)])
    (define-c-local start &start agg 0)
    (define-c-local end &end agg 16)
    (define-c-local cs &cs s32 32)
    (define-c-local ce &ce s32 36)
    (mem-copy! start start.in 16)
    (mem-copy! end end.in 16)
    (let* ([plen (ml_get_len ed lnum)] [p (ml_get ed lnum)])
      (define (join6 startcol endcol)
        (define (join12 endcol)
          (define (join14 endcol)
            (if (or (fx>? startcol endcol) (block_def.is_oneChar bdp))
                (block_def.textlen-set! bdp 0)
                (block_def.textlen-set! bdp (fx+ (fx- endcol startcol) inclusive)))
            (block_def.textcol-set! bdp startcol)
            (block_def.textstart-set! bdp (if (fx<=? startcol plen) (fx+ p startcol) p))
            (frame-pop! ed fr))
          (if (fx=? endcol MAXCOL) (join14 (ml_get_len ed lnum)) (join14 endcol)))
        (if (= lnum (pos_T.lnum end))
            (let ([endcol (pos_T.col end)])
              (cond
                [(fxzero? virtual_op) (join12 endcol)]
                [else
                 (getvcol ed curwin end &cs 0 &ce 0)
                 (if (or (fx=? (ld-u8 (fx+ p endcol)) NUL)
                         (and (fx<? (fx+ cs (pos_T.coladd end)) ce)
                              (fxzero? (utf_head_off ed p (fx+ p endcol)))))
                     (cond
                       [(and (= (pos_T.lnum start) (pos_T.lnum end))
                             (fx=? (pos_T.col start) (pos_T.col end)))
                        (block_def.is_oneChar-set! bdp #t)
                        (block_def.startspaces-set! bdp
                                                    (fx+ (fx- (pos_T.coladd end)
                                                              (pos_T.coladd start)) inclusive))
                        (join12 startcol)]
                       [else
                        (block_def.endspaces-set! bdp (fx+ (pos_T.coladd end) inclusive))
                        (join12 (fx- endcol inclusive))])
                     (join12 endcol))]))
            (join12 endcol)))
      (block_def.startspaces-set! bdp 0)
      (block_def.endspaces-set! bdp 0)
      (block_def.is_oneChar-set! bdp #f)
      (block_def.start_char_vcols-set! bdp 0)
      (if (= lnum (pos_T.lnum start))
          (let ([startcol (pos_T.col start)])
            (cond
              [(fxzero? virtual_op) (join6 startcol MAXCOL)]
              [else
               (getvcol ed curwin start &cs 0 &ce 0)
               (cond
