;; The address of IObuff, for the host.
(define addr:IObuff 69096)

;; The host's functions, in the order of the vector of procedures an
;; editor is made on.
(define host-names '#(host_alloc host_exit host_message host_raise host_time host_write musl_delay musl_get_winsize musl_host_init musl_now_ms musl_read_input musl_suspend musl_term_start musl_term_stop musl_tty_keys musl_wait_for_input vim_snprintf))
(define (host_alloc ed a0) ((vector-ref (ed-glue ed) 0) ed a0))
(define (host_exit ed a0) ((vector-ref (ed-glue ed) 1) ed a0))
(define (host_message ed a0 a1 a2) ((vector-ref (ed-glue ed) 2) ed a0 a1 a2))
(define (host_raise ed a0) ((vector-ref (ed-glue ed) 3) ed a0))
(define (host_time ed) ((vector-ref (ed-glue ed) 4) ed))
(define (host_write ed a0 a1) ((vector-ref (ed-glue ed) 5) ed a0 a1))
(define (musl_delay ed a0 a1) ((vector-ref (ed-glue ed) 6) ed a0 a1))
(define (musl_get_winsize ed a0 a1) ((vector-ref (ed-glue ed) 7) ed a0 a1))
(define (musl_host_init ed) ((vector-ref (ed-glue ed) 8) ed))
(define (musl_now_ms ed) ((vector-ref (ed-glue ed) 9) ed))
(define (musl_read_input ed a0 a1) ((vector-ref (ed-glue ed) 10) ed a0 a1))
(define (musl_suspend ed) ((vector-ref (ed-glue ed) 11) ed))
(define (musl_term_start ed) ((vector-ref (ed-glue ed) 12) ed))
(define (musl_term_stop ed) ((vector-ref (ed-glue ed) 13) ed))
(define (musl_tty_keys ed a0 a1 a2 a3 a4) ((vector-ref (ed-glue ed) 14) ed a0 a1 a2 a3 a4))
(define (musl_wait_for_input ed a0) ((vector-ref (ed-glue ed) 15) ed a0))
(define (vim_snprintf ed a0 a1 a2 args) ((vector-ref (ed-glue ed) 16) ed a0 a1 a2 args))

(define (ascii_isupper ed c)
  (fx<? (u32- (->u32 c) 65) 26))

(define (ascii_islower ed c)
  (fx<? (u32- (->u32 c) 97) 26))

(define (ascii_isdigit ed c)
  (fx<? (u32- (->u32 c) 48) 10))

(define (musl_memcpy ed dest src n)
  (let ([mem (ed-mem ed)])
    (define (loop1 n d s)
      (if (not (eqv? n 0))
          (let* ([t1 d]
                 [d (fx+ d 1)]
                 [t2 s]
                 [s (fx+ s 1)]
                 [r1 (ld-u8 t2)])
            (st-u8! t1 r1)
            (let ([n (u64- n 1)])
              (loop1 n d s)))
          dest))
    (let* ([d dest]
           [s src])
      (loop1 n d s))))

(define (musl_memmove ed dest src n)
  (let ([mem (ed-mem ed)])
    (define (loop3 n d s)
      (if (not (eqv? n 0))
          (let* ([n (u64- n 1)]
                 [r1 (ld-u8 (fx+ s (->i64 n)))])
            (st-u8! (fx+ d (->i64 n)) r1)
            (loop3 n d s))
          (join7)))
    (define (loop6 n d s)
      (if (not (eqv? n 0))
          (let* ([t1 d]
                 [d (fx+ d 1)]
                 [t2 s]
                 [s (fx+ s 1)]
                 [r2 (ld-u8 t2)])
            (st-u8! t1 r2)
            (let ([n (u64- n 1)])
              (loop6 n d s)))
          (join7)))
    (define (join7)
      dest)
    (let* ([d dest]
           [s src])
      (if (fx=? d s) dest (if (fx<? d s) (loop6 n d s) (loop3 n d s))))))

(define (musl_memset ed dest c n)
  (let ([mem (ed-mem ed)])
    (define (loop1 n s)
      (if (not (eqv? n 0))
          (let* ([t1 s]
                 [s (fx+ s 1)])
            (st-u8! t1 (->u8 c))
            (let ([n (u64- n 1)])
              (loop1 n s)))
          dest))
    (let ([s dest])
      (loop1 n s))))

(define (musl_memcmp ed vl vr n)
  (let ([mem (ed-mem ed)])
    (define (loop1 n l r)
      (let ([r3 (and (not (eqv? n 0))
                     (let* ([r1 (ld-u8 l)]
                            [r2 (ld-u8 r)])
                       (fx=? r1 r2)))])
        (if r3
            (let* ([n (u64- n 1)]
                   [l (fx+ l 1)]
                   [r (fx+ r 1)])
              (loop1 n l r))
            (let ([r6 (if (not (eqv? n 0))
                          (let* ([r4 (ld-u8 l)]
                                 [r5 (ld-u8 r)])
                            (i32- r4 r5))
                          0)])
              r6))))
    (let* ([l vl]
           [r vr])
      (loop1 n l r))))

(define (musl_strlen ed s)
  (let ([mem (ed-mem ed)])
    (define (loop1 s a)
      (let ([r1 (ld-s8 s)])
        (if (not (fxzero? r1))
            (let ([s (fx+ s 1)])
              (loop1 s a))
            (->u64 (fx- s a)))))
    (let ([a s])
      (loop1 s a))))

(define (musl_strcpy ed dest src)
  (let ([mem (ed-mem ed)])
    (define (loop1 src d)
      (let ([r1 (ld-s8 src)])
        (st-s8! d r1)
        (let ([r2 (ld-s8 d)])
          (if (not (fx=? r2 0))
              (let* ([d (fx+ d 1)]
                     [src (fx+ src 1)])
                (loop1 src d))
              dest))))
    (let ([d dest])
      (loop1 src d))))

(define (musl_strncpy ed dest src n)
  (let ([mem (ed-mem ed)])
    (define (loop1 src n d)
      (let ([r2 (and (not (eqv? n 0))
                     (let ([r1 (ld-s8 src)])
                       (not (fxzero? r1))))])
        (if r2
            (let* ([t1 d]
                   [d (fx+ d 1)]
                   [t2 src]
                   [src (fx+ src 1)]
                   [r3 (ld-s8 t2)])
              (st-s8! t1 r3)
              (let ([n (u64- n 1)])
                (loop1 src n d)))
            (loop3 n d))))
    (define (loop3 n d)
      (if (not (eqv? n 0))
          (let* ([t3 d]
                 [d (fx+ d 1)])
            (st-s8! t3 0)
            (let ([n (u64- n 1)])
              (loop3 n d)))
          dest))
    (let ([d dest])
      (loop1 src n d))))

(define (musl_strcat ed dest src)
  (let ([r1 (musl_strlen ed dest)])
    (musl_strcpy ed (fx+ dest (->i64 r1)) src)
    dest))

(define (musl_strcmp ed l r)
  (let ([mem (ed-mem ed)])
    (define (loop1 l r)
      (let* ([r1 (ld-s8 l)]
             [r2 (ld-s8 r)]
             [r4 (and (fx=? r1 r2)
                      (let ([r3 (ld-s8 l)])
                        (not (fxzero? r3))))])
        (if r4
