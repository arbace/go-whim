                  (block_def.startspaces-set! bdp
                                              (fx- (block_def.start_char_vcols bdp)
                                                   (pos_T.coladd start)))
                  (when (fx<? (block_def.startspaces bdp) 0) (block_def.startspaces-set! bdp 0))
                  (join6 (fx+ startcol 1) MAXCOL)]
                 [else (join6 startcol MAXCOL)])]))
          (join6 0 MAXCOL)))))

(define (op_addsub ed oap Prenum1 g_cmd)
  (let* ([mem (ed-mem ed)] [fr (frame-push! ed 80)])
    (define-c-local pos &pos agg 0)
    (define-c-local bd &bd agg 16)
    (define (loop3 change_cnt amount startpos_lnum startpos_col startpos_coladd)
      (define (join24 length_)
        (let ([one_change (do_addsub ed (oparg_T.op_type oap) pos length_ amount)])
          (define (join27 startpos_lnum startpos_col startpos_coladd)
            (join28 (fx+ change_cnt 1) startpos_lnum startpos_col startpos_coladd))
          (define (join28 change_cnt startpos_lnum startpos_col startpos_coladd)
            (define (join30 amount)
              (pos_T.lnum-set! pos (+ (pos_T.lnum pos) 1))
              (loop3 change_cnt amount startpos_lnum startpos_col startpos_coladd))
            (if (and (not (fxzero? g_cmd)) one_change) (join30 (+ amount Prenum1)) (join30 amount)))
          (if one_change
              (if (fxzero? change_cnt)
                  (let* ([startpos_lnum (buf_T.b_op_start.lnum curbuf)]
                         [startpos_col (buf_T.b_op_start.col curbuf)])
                    (join27 startpos_lnum startpos_col (buf_T.b_op_start.coladd curbuf)))
                  (join27 startpos_lnum startpos_col startpos_coladd))
              (join28 change_cnt startpos_lnum startpos_col startpos_coladd))))
      (cond
        [(<= (pos_T.lnum pos) (oparg_T.end.lnum oap))
         (cond
           [(not (fxzero? (oparg_T.block_mode oap)))
            (block_prep ed oap bd (pos_T.lnum pos) FALSE)
            (pos_T.col-set! pos (block_def.textcol bd))
            (join24 (block_def.textlen bd))]
           [(fx=? (oparg_T.motion_type oap) MLINE)
            (win_T.w_cursor.col-set! curwin 0)
            (pos_T.col-set! pos 0)
            (join24 (ml_get_len ed (pos_T.lnum pos)))]
           [else
            (when (and (= (pos_T.lnum pos) (oparg_T.start.lnum oap))
                       (fxzero? (oparg_T.inclusive oap)))
              (dec ed (oparg_T.end& oap)))
            (let ([length_ (ml_get_len ed (pos_T.lnum pos))])
              (define (join18 length_)
                (if (= (pos_T.lnum pos) (oparg_T.end.lnum oap))
                    (let ([length_ (ml_get_len ed (oparg_T.end.lnum oap))])
                      (when (fx>=? (oparg_T.end.col oap) length_)
                        (oparg_T.end.col-set! oap (fx- length_ 1)))
                      (join24 (fx+ (fx- (oparg_T.end.col oap) (pos_T.col pos)) 1)))
                    (join24 length_)))
              (pos_T.col-set! pos 0)
              (cond
                [(= (pos_T.lnum pos) (oparg_T.start.lnum oap))
                 (pos_T.col-set! pos (fx+ (pos_T.col pos) (oparg_T.start.col oap)))
                 (join18 (fx- length_ (oparg_T.start.col oap)))]
                [else (join18 length_)]))])]
        [else
         (unless (fxzero? change_cnt)
           (changed_lines ed (oparg_T.start.lnum oap) 0 (+ (oparg_T.end.lnum oap) 1) 0))
         (when (and (fxzero? change_cnt) (not (fxzero? (oparg_T.is_VIsual oap))))
           (redraw_curbuf_later ed UPD_INVERTED))
         (when (and (fx>? change_cnt 0)
                    (fxzero? (fxand (cmdmod_T.cmod_flags cmdmod) CMOD_LOCKMARKS)))
           (buf_T.b_op_start.lnum-set! curbuf startpos_lnum)
           (buf_T.b_op_start.col-set! curbuf startpos_col)
           (buf_T.b_op_start.coladd-set! curbuf startpos_coladd))
         (if (> change_cnt p_report)
             (let* ([r1 IObuff] [r2 (iobuff_room ed)])
               (vim_snprintf ed r1 r2
                             (NGETTEXT (c-str 165053 "%d line changed")
                                       (c-str 165069 "%d lines changed") (->u64 change_cnt))
                             (list change_cnt))
               (msg ed
                    (iobuff_or ed
                               (NGETTEXT (c-str 165053 "%d line changed")
                                         (c-str 165069 "%d lines changed") (->u64 change_cnt))))
               (join35))
             (join35))]))
