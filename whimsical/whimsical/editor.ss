                    [(fx=? (ld-u8 (fx+ linep (fx+ (pos_T.col findmatchlimit:pos) 1))) (ch #\*))
                     (pos_T.col-set! findmatchlimit:pos (fx+ (pos_T.col findmatchlimit:pos) 1))
                     (join22 #f hash_dir FORWARD)]
                    [(and (fx>? (pos_T.col findmatchlimit:pos) 0)
                          (fx=? (ld-u8 (fx+ linep (fx- (pos_T.col findmatchlimit:pos) 1)))
                                (ch #\*)))
                     (pos_T.col-set! findmatchlimit:pos (fx- (pos_T.col findmatchlimit:pos) 1))
                     (join22 #t hash_dir -1)]
                    [else (join22 backwards hash_dir comment_dir)])]
                 [(fx=? (ld-u8 (fx+ linep (pos_T.col findmatchlimit:pos))) (ch #\*))
                  (cond
                    [(fx=? (ld-u8 (fx+ linep (fx+ (pos_T.col findmatchlimit:pos) 1))) (ch #\/))
                     (join22 #t hash_dir -1)]
                    [(and (fx>? (pos_T.col findmatchlimit:pos) 0)
                          (fx=? (ld-u8 (fx+ linep (fx- (pos_T.col findmatchlimit:pos) 1)))
                                (ch #\/)))
                     (join22 #f hash_dir FORWARD)]
                    [else (join22 backwards hash_dir comment_dir)])]
                 [else (join22 backwards hash_dir comment_dir)]))]))
        (cond
          [(not (fxzero? (fxand flags FM_BACKWARD)))
           (join5 0 0 #f #f FALSE 0 0 0 #f 0 -1 MAXCOL #f 0 0 #f)]
          [(fxzero? (fxand flags FM_FORWARD)) (join5 0 0 #f #f FALSE 0 0 0 #f 0 0 MAXCOL #f 0 0 #f)]
          [else (join5 0 0 #f #f FALSE 0 0 0 #f 0 FORWARD MAXCOL #f 0 0 #f)])))))

(define (showmatch ed c)
  (let* ([mem (ed-mem ed)] [fr (frame-push! ed 16)])
    (define-c-local vcol &vcol s32 0)
    (let* ([so (if (>= (win_T.w_onebuf_opt.wo_so curwin) 0)
                   (win_T.w_onebuf_opt.wo_so& curwin)
                   &p_so)]
           [siso (if (>= (win_T.w_onebuf_opt.wo_siso curwin) 0)
                     (win_T.w_onebuf_opt.wo_siso& curwin)
                     &p_siso)])
      (let loop1 ([p (buf_T.b_p_mps curbuf)])
        (define (join6 p)
          (if (fx=? (ld-u8 p) NUL)
              (frame-pop! ed fr)
              (let ([lpos (findmatch ed 0 NUL)])
                (cond
                  [(fxzero? lpos) (vim_beep ed BO_MATCH) (frame-pop! ed fr)]
                  [(or (< (pos_T.lnum lpos) (win_T.w_topline curwin))
                       (>= (pos_T.lnum lpos) (win_T.w_botline curwin)))
                   (frame-pop! ed fr)]
                  [else
                   (when (fxzero? (win_T.w_onebuf_opt.wo_wrap curwin))
                     (getvcol ed curwin lpos 0 &vcol 0 0))
                   (let ([col_visible (or (not (fxzero? (win_T.w_onebuf_opt.wo_wrap curwin)))
                                          (and (fx>=? vcol (win_T.w_leftcol curwin))
                                               (fx<? vcol
                                                     (fx+ (win_T.w_leftcol curwin)
                                                          (win_T.w_width curwin)))))])
                     (if col_visible
                         (let* ([mpos_lnum (pos_T.lnum lpos)]
                                [mpos_col (pos_T.col lpos)]
                                [mpos_coladd (pos_T.coladd lpos)]
                                [save_cursor_lnum (win_T.w_cursor.lnum curwin)]
                                [save_cursor_col (win_T.w_cursor.col curwin)]
                                [save_cursor_coladd (win_T.w_cursor.coladd curwin)]
                                [save_so (ld-s64 so)]
                                [save_siso (ld-s64 siso)])
                           (when (and (fx>=? dollar_vcol 0)
                                      (fx=? dollar_vcol (win_T.w_virtcol curwin)))
                             (set! dollar_vcol -1))
                           (let ([r1 curwin])
                             (win_T.w_virtcol-set! r1 (fx+ (win_T.w_virtcol r1) 1))
                             (update_screen ed UPD_VALID)
                             (let ([save_dollar_vcol dollar_vcol])
                               (win_T.w_cursor.lnum-set! curwin mpos_lnum)
                               (win_T.w_cursor.col-set! curwin mpos_col)
                               (win_T.w_cursor.coladd-set! curwin mpos_coladd)
                               (st-s64! so 0)
                               (st-s64! siso 0)
                               (showruler ed #f)
                               (setcursor ed)
                               (cursor_on ed)
                               (out_flush_cursor ed #t #f)
                               (set! dollar_vcol save_dollar_vcol)
                               (if (fxzero? (vim_strchr ed p_cpo CPO_SHOWMATCH))
                                   (unless (char_avail ed) (ui_delay ed (+ (* p_mat 100) 9) #f))
                                   (ui_delay ed (+ (* p_mat 100) 8) #t))
                               (win_T.w_cursor.lnum-set! curwin save_cursor_lnum)
                               (win_T.w_cursor.col-set! curwin save_cursor_col)
                               (win_T.w_cursor.coladd-set! curwin save_cursor_coladd)
                               (st-s64! so save_so)
                               (st-s64! siso save_siso)
                               (frame-pop! ed fr))))
                         (frame-pop! ed fr)))]))))
        (if (fx=? (ld-u8 p) NUL)
            (join6 p)
            (let* ([t1 (fx+ (utfc_ptr2len ed p) 1)] [p (fx+ p t1)])
              (if (fx=? (utf_ptr2char ed p) c)
                  (join6 p)
                  (let* ([t2 (utfc_ptr2len ed p)] [p (fx+ p t2)])
                    (if (fx=? (ld-u8 p) NUL) (frame-pop! ed fr) (loop1 (fx+ p 1)))))))))))

(define (is_zero_width ed pattern patternlen move cur direction)
  (let* ([mem (ed-mem ed)] [fr (frame-push! ed 368)])
    (define-c-local regmatch &regmatch agg 0)
    (define-c-local pos &pos agg 344)
    (define (join12 result)
      (vim_regfree (regmmatch_T.regprog regmatch))
      (frame-pop! ed fr)
      result)
    (let ([called_emsg_before called_emsg])
      (define (join2 pattern patternlen result flag)
        (define (join6 flag)
          (if (fx=? (searchit ed curwin curbuf pos 0 direction pattern patternlen 1
                              (fx+ SEARCH_KEEP flag) RE_SEARCH 0) FAIL)
              (join12 result)
              (let loop8 ()
                (lpos_T.col-set! (regmmatch_T.startpos& regmatch)
                                 (fx+ (lpos_T.col (regmmatch_T.startpos& regmatch)) 1))
                (let ([nmatched (->i32 (vim_regexec_multi ed regmatch curwin curbuf (pos_T.lnum pos)
                                                          (lpos_T.col (regmmatch_T.startpos& regmatch))
                                                          0))])
                  (define (join10)
                    (if (fx=? called_emsg called_emsg_before)
                        (join12 (b->i (and (not (fxzero? nmatched))
                                           (= (lpos_T.lnum (regmmatch_T.startpos& regmatch))
                                              (lpos_T.lnum (regmmatch_T.endpos& regmatch)))
                                           (fx=? (lpos_T.col (regmmatch_T.startpos& regmatch))
                                                 (lpos_T.col (regmmatch_T.endpos& regmatch))))))
                        (join12 result)))
                  (cond
                    [(not (fxzero? nmatched)) (join10)]
                    [(and (not (fxzero? (regmmatch_T.regprog regmatch)))
                          (not (fxzero? (if (fx=? direction FORWARD)
                                            (b->i (fx<? (lpos_T.col (regmmatch_T.startpos& regmatch))
                                                        (pos_T.col pos)))
                                            (b->i (fx>? (lpos_T.col (regmmatch_T.startpos& regmatch))
                                                        (pos_T.col pos)))))))
                     (loop8)]
                    [else (join10)])))))
        (cond
          [(search_regcomp ed pattern patternlen 0 RE_SEARCH RE_SEARCH SEARCH_KEEP regmatch)
           (lpos_T.col-set! (regmmatch_T.startpos& regmatch) -1)
           (cond
             [move
              (pos_T.lnum-set! pos 0)
              (pos_T.col-set! pos 0)
              (pos_T.coladd-set! pos 0)
              (join6 flag)]
             [else (mem-copy! pos cur 16) (join6 SEARCH_START)])]
          [else (frame-pop! ed fr) -1]))
      (if (fxzero? pattern)
          (let ([pattern (spat_T.pat (fx+ spats (fx* last_idx 48)))])
            (join2 pattern (spat_T.patlen (fx+ spats (fx* last_idx 48))) -1 0))
          (join2 pattern patternlen -1 0)))))

(define (current_search ed count forward)
  (let* ([mem (ed-mem ed)] [fr (frame-push! ed 32)])
    (define-c-local end_pos &end_pos agg 0)
    (define-c-local pos &pos agg 16)
    (define (loop8 i old_p_ws zero_width skip_first_backward orig_pos_lnum orig_pos_col
                   orig_pos_coladd save_VIsual_lnum save_VIsual_col save_VIsual_coladd)
      (define (join27 dir)
        (define (join29 flags)
          (mem-copy! end_pos pos 16)
          (when (fxzero? i) (set! p_ws FALSE))
          (let ([result (searchit ed curwin curbuf pos end_pos (if (fxzero? dir) -1 FORWARD)
                                  (spat_T.pat (fx+ spats (fx* last_idx 48)))
                                  (spat_T.patlen (fx+ spats (fx* last_idx 48)))
                                  (if (fxzero? i) 1 count) (fxior SEARCH_KEEP flags) RE_SEARCH 0)])
            (set! p_ws old_p_ws)
            (cond
              [(and (fx=? i 1) (fxzero? result))
               (let ([r1 curwin])
                 (win_T.w_cursor.lnum-set! r1 orig_pos_lnum)
                 (win_T.w_cursor.col-set! r1 orig_pos_col)
                 (win_T.w_cursor.coladd-set! r1 orig_pos_coladd)
                 (when VIsual_active
                   (pos_T.lnum-set! VIsual save_VIsual_lnum)
                   (pos_T.col-set! VIsual save_VIsual_col)
                   (pos_T.coladd-set! VIsual save_VIsual_coladd))
                 (frame-pop! ed fr)
                 #f)]
              [else
               (when (and (fxzero? i) (fxzero? result))
                 (cond
                   [forward
                    (pos_T.lnum-set! pos 0)
                    (pos_T.col-set! pos 0)
                    (pos_T.coladd-set! pos 0)]
                   [else
                    (pos_T.lnum-set! pos (buf_T.b_ml.ml_line_count (win_T.w_buffer curwin)))
                    (pos_T.col-set! pos
                                    (ml_get_len ed
                                                (buf_T.b_ml.ml_line_count (win_T.w_buffer curwin))))]))
               (join39)])))
        (if (and (fxzero? dir) (fxzero? zero_width)) (join29 SEARCH_END) (join29 0)))
      (define (join39)
        (loop8 (fx+ i 1) old_p_ws zero_width skip_first_backward orig_pos_lnum orig_pos_col
               orig_pos_coladd save_VIsual_lnum save_VIsual_col save_VIsual_coladd))
      (if (fx<? i 2)
          (if forward
              (if (and (fxzero? i) skip_first_backward) (join39) (join27 i))
              (join27 (b->i (fxzero? i))))
          (let* ([start_pos_lnum (pos_T.lnum pos)]
                 [start_pos_col (pos_T.col pos)]
                 [start_pos_coladd (pos_T.coladd pos)])
            (unless VIsual_active
              (pos_T.lnum-set! VIsual start_pos_lnum)
              (pos_T.col-set! VIsual start_pos_col)
              (pos_T.coladd-set! VIsual start_pos_coladd))
            (mem-copy! (win_T.w_cursor& curwin) end_pos 16)
            (if (and (not (fxzero? (if (= (pos_T.lnum VIsual) (pos_T.lnum end_pos))
                                       (if (fx=? (pos_T.col VIsual) (pos_T.col end_pos))
                                           (b->i (fx<? (pos_T.coladd VIsual)
                                                       (pos_T.coladd end_pos)))
                                           (b->i (fx<? (pos_T.col VIsual) (pos_T.col end_pos))))
                                       (b->i (< (pos_T.lnum VIsual) (pos_T.lnum end_pos))))))
                     forward)
                (if skip_first_backward (mem-copy! (win_T.w_cursor& curwin) pos 16) (dec_cursor ed))
                (when (and VIsual_active
                           (not (fxzero? (if (= (win_T.w_cursor.lnum curwin) (pos_T.lnum VIsual))
                                             (if (fx=? (win_T.w_cursor.col curwin)
                                                       (pos_T.col VIsual))
                                                 (b->i (fx<? (win_T.w_cursor.coladd curwin)
                                                             (pos_T.coladd VIsual)))
                                                 (b->i (fx<? (win_T.w_cursor.col curwin)
                                                             (pos_T.col VIsual))))
                                             (b->i (< (win_T.w_cursor.lnum curwin)
                                                      (pos_T.lnum VIsual))))))
                           forward)
                  (mem-copy! (win_T.w_cursor& curwin) pos 16)))
            (set! VIsual_active #t)
            (set! VIsual_mode (ch #\v))
            (when (fx=? (ld-u8 p_sel) (ch #\e))
              (if (and forward
                       (or (not (fxzero? (if (= (pos_T.lnum VIsual) (win_T.w_cursor.lnum curwin))
                                             (if (fx=? (pos_T.col VIsual)
                                                       (win_T.w_cursor.col curwin))
                                                 (b->i (fx<? (pos_T.coladd VIsual)
                                                             (win_T.w_cursor.coladd curwin)))
                                                 (b->i (fx<? (pos_T.col VIsual)
                                                             (win_T.w_cursor.col curwin))))
                                             (b->i (< (pos_T.lnum VIsual)
                                                      (win_T.w_cursor.lnum curwin))))))
                           (and (= (pos_T.lnum VIsual) (win_T.w_cursor.lnum curwin))
                                (fx=? (pos_T.col VIsual) (win_T.w_cursor.col curwin))
                                (fx=? (pos_T.coladd VIsual) (win_T.w_cursor.coladd curwin)))))
                  (inc_cursor ed)
                  (when (and (not forward)
                             (or (not (fxzero? (if (= (win_T.w_cursor.lnum curwin)
                                                      (pos_T.lnum VIsual))
                                                   (if (fx=? (win_T.w_cursor.col curwin)
                                                             (pos_T.col VIsual))
                                                       (b->i (fx<? (win_T.w_cursor.coladd curwin)
                                                                   (pos_T.coladd VIsual)))
                                                       (b->i (fx<? (win_T.w_cursor.col curwin)
                                                                   (pos_T.col VIsual))))
                                                   (b->i (< (win_T.w_cursor.lnum curwin)
                                                            (pos_T.lnum VIsual))))))
                                 (and (= (win_T.w_cursor.lnum curwin) (pos_T.lnum VIsual))
                                      (fx=? (win_T.w_cursor.col curwin) (pos_T.col VIsual))
                                      (fx=? (win_T.w_cursor.coladd curwin) (pos_T.coladd VIsual)))))
                    (inc ed VIsual))))
            (may_start_select ed (ch #\c))
            (redraw_curbuf_later ed UPD_INVERTED)
            (showmode ed)
            (frame-pop! ed fr)
            #t)))
    (let* ([old_p_ws (->u8 p_ws)]
           [save_VIsual_lnum (pos_T.lnum VIsual)]
           [save_VIsual_col (pos_T.col VIsual)]
           [save_VIsual_coladd (pos_T.coladd VIsual)])
      (when (and VIsual_active
                 (fx=? (ld-u8 p_sel) (ch #\e))
                 (not (fxzero? (if (= (pos_T.lnum VIsual) (win_T.w_cursor.lnum curwin))
                                   (if (fx=? (pos_T.col VIsual) (win_T.w_cursor.col curwin))
                                       (b->i (fx<? (pos_T.coladd VIsual)
                                                   (win_T.w_cursor.coladd curwin)))
                                       (b->i (fx<? (pos_T.col VIsual) (win_T.w_cursor.col curwin))))
                                   (b->i (< (pos_T.lnum VIsual) (win_T.w_cursor.lnum curwin)))))))
        (dec_cursor ed))
      (let ([skip_first_backward (and forward
                                      VIsual_active
                                      (not (fxzero? (if (= (win_T.w_cursor.lnum curwin)
                                                           (pos_T.lnum VIsual))
                                                        (if (fx=? (win_T.w_cursor.col curwin)
                                                                  (pos_T.col VIsual))
                                                            (b->i (fx<? (win_T.w_cursor.coladd curwin)
                                                                        (pos_T.coladd VIsual)))
                                                            (b->i (fx<? (win_T.w_cursor.col curwin)
                                                                        (pos_T.col VIsual))))
                                                        (b->i (< (win_T.w_cursor.lnum curwin)
                                                                 (pos_T.lnum VIsual)))))))])
        (mem-copy! pos (win_T.w_cursor& curwin) 16)
        (let* ([orig_pos_lnum (pos_T.lnum pos)]
               [orig_pos_col (pos_T.col pos)]
               [orig_pos_coladd (pos_T.coladd pos)])
          (when VIsual_active (if forward (incl ed pos) (decl ed pos)))
          (let ([zero_width (is_zero_width ed (spat_T.pat (fx+ spats (fx* last_idx 48)))
                                           (spat_T.patlen (fx+ spats (fx* last_idx 48))) #t
                                           (win_T.w_cursor& curwin) FORWARD)])
            (cond
              [(fx=? zero_width -1) (frame-pop! ed fr) #f]
              [else
               (loop8 0 old_p_ws zero_width skip_first_backward orig_pos_lnum orig_pos_col
                      orig_pos_coladd save_VIsual_lnum save_VIsual_col save_VIsual_coladd)])))))))

(define (cmdline_search_stat ed dirc pos cursor_pos show_top_bot_msg msgbuf msgbuflen recompute
                             maxcount timeout)
  (let* ([mem (ed-mem ed)] [fr (frame-push! ed 48)])
    (define-c-local stat &stat agg 0)
    (define-c-local t &t agg 20)
    (define (join8 len)
      (cond
        [(and show_top_bot_msg (< (u64+ len 2) SEARCH_STAT_BUF_LEN))
         (musl_memmove ed (fx+ t 2) t len)
         (st-s8! t (ch #\W))
         (st-s8! (fx+ t 1) (ch #\space))
         (join10 (u64+ len 2))]
        [else (join10 len)]))
    (define (join10 len)
      (if (> len msgbuflen) (join12 msgbuflen) (join12 len)))
    (define (join12 len)
      (musl_memmove ed (fx+ (fx+ msgbuf (->i64 msgbuflen)) (fx- 0 (->i64 len))) t len)
      (when (and (fx=? dirc (ch #\?)) (fx=? (searchstat_T.cur stat) (fx+ maxcount 1)))
        (searchstat_T.cur-set! stat -1))
      (set! msg_hist_off #t)
      (give_warning ed msgbuf #f)
      (set! msg_hist_off #f)
      (frame-pop! ed fr))
    (update_search_stat ed dirc pos cursor_pos stat recompute maxcount timeout)
    (cond
      [(fx<=? (searchstat_T.cur stat) 0) (frame-pop! ed fr)]
      [(fx=? (searchstat_T.incomplete stat) 1)
       (join8 (->u64 (vim_snprintf ed t SEARCH_STAT_BUF_LEN (c-str 166551 "[?/??]") '())))]
      [(and (fx>? (searchstat_T.cnt stat) maxcount) (fx>? (searchstat_T.cur stat) maxcount))
       (join8 (->u64 (vim_snprintf ed t SEARCH_STAT_BUF_LEN (c-str 166558 "[>%d/>%d]")
                                   (list maxcount maxcount))))]
      [(fx>? (searchstat_T.cnt stat) maxcount)
       (join8 (->u64 (vim_snprintf ed t SEARCH_STAT_BUF_LEN (c-str 166568 "[%d/>%d]")
                                   (list (searchstat_T.cur stat) maxcount))))]
      [else
       (join8 (->u64 (vim_snprintf ed t SEARCH_STAT_BUF_LEN (c-str 166577 "[%d/%d]")
                                   (list (searchstat_T.cur stat) (searchstat_T.cnt stat)))))])))

(define (update_search_stat ed dirc pos cursor_pos stat recompute maxcount timeout)
  (let* ([mem (ed-mem ed)] [fr (frame-push! ed 16)])
    (define-c-local endpos &endpos agg 0)
    (define (loop5 save_ws p_lnum p_col p_coladd done_search)
      (define (join12 done_search)
        (unless (fxzero? got_int) (set! update_search_stat:cur -1))
        (when done_search
          (set! update_search_stat:lastpat
                (vim_strnsave ed (spat_T.pat (fx+ spats (fx* last_idx 48)))
                              (spat_T.patlen (fx+ spats (fx* last_idx 48)))))
          (set! update_search_stat:lastpatlen (spat_T.patlen (fx+ spats (fx* last_idx 48))))
          (set! update_search_stat:chgtick (->i32 (buf_T.b_changedtick curbuf)))
          (set! update_search_stat:lbuf curbuf)
          (pos_T.lnum-set! update_search_stat:lastpos p_lnum)
          (pos_T.col-set! update_search_stat:lastpos p_col)
          (pos_T.coladd-set! update_search_stat:lastpos p_coladd))
        (join17 save_ws))
      (cond
        [(and (fxzero? got_int)
              (not (fx=? (searchit ed curwin curbuf update_search_stat:lastpos endpos FORWARD 0 0 1
                                   SEARCH_KEEP RE_LAST 0) FAIL)))
         (set! update_search_stat:cnt (fx+ update_search_stat:cnt 1))
         (when (or (not (fxzero? (if (= (pos_T.lnum update_search_stat:lastpos) p_lnum)
                                     (if (fx=? (pos_T.col update_search_stat:lastpos) p_col)
                                         (b->i (fx<? (pos_T.coladd update_search_stat:lastpos)
                                                     p_coladd))
                                         (b->i (fx<? (pos_T.col update_search_stat:lastpos) p_col)))
                                     (b->i (< (pos_T.lnum update_search_stat:lastpos) p_lnum)))))
                   (and (= (pos_T.lnum update_search_stat:lastpos) p_lnum)
                        (fx=? (pos_T.col update_search_stat:lastpos) p_col)
                        (fx=? (pos_T.coladd update_search_stat:lastpos) p_coladd)))
           (set! update_search_stat:cur update_search_stat:cnt)
           (unless (fxzero? (if (= p_lnum (pos_T.lnum endpos))
                                (if (fx=? p_col (pos_T.col endpos))
                                    (b->i (fx<? p_coladd (pos_T.coladd endpos)))
                                    (b->i (fx<? p_col (pos_T.col endpos))))
                                (b->i (< p_lnum (pos_T.lnum endpos)))))
             (set! update_search_stat:exact_match #t)))
         (fast_breakcheck ed)
         (cond
           [(and (fx>? maxcount 0) (fx>? update_search_stat:cnt maxcount))
            (set! update_search_stat:incomplete 2)
            (join12 #t)]
           [else (loop5 save_ws p_lnum p_col p_coladd #t)])]
        [else (join12 done_search)]))
    (define (join17 save_ws)
      (searchstat_T.cur-set! stat update_search_stat:cur)
      (searchstat_T.cnt-set! stat update_search_stat:cnt)
      (searchstat_T.exact_match-set! stat update_search_stat:exact_match)
      (searchstat_T.incomplete-set! stat update_search_stat:incomplete)
      (searchstat_T.last_maxcount-set! stat update_search_stat:last_maxcount)
      (set! p_ws save_ws)
      (frame-pop! ed fr))
    (let* ([save_ws p_ws]
           [p_lnum (pos_T.lnum pos)]
           [p_col (pos_T.col pos)]
           [p_coladd (pos_T.coladd pos)])
      (musl_memset ed stat 0 20)
      (cond
        [(and (fxzero? dirc)
              (not recompute)
              (not (and (zero? (pos_T.lnum update_search_stat:lastpos))
                        (fxzero? (pos_T.col update_search_stat:lastpos))
                        (fxzero? (pos_T.coladd update_search_stat:lastpos)))))
         (searchstat_T.cur-set! stat update_search_stat:cur)
         (searchstat_T.cnt-set! stat update_search_stat:cnt)
         (searchstat_T.exact_match-set! stat update_search_stat:exact_match)
         (searchstat_T.incomplete-set! stat update_search_stat:incomplete)
         (searchstat_T.last_maxcount-set! stat update_search_stat:last_maxcount)
         (frame-pop! ed fr)]
