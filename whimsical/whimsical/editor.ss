;; The address of IObuff, for the host.
(define addr:IObuff 69096)

;; The host's functions, in the order of the vector of procedures an
;; editor is made on.
(define host-names '#(host_alloc host_exit host_message host_raise host_time host_write musl_delay musl_get_winsize musl_host_init musl_now_ms musl_read_input musl_suspend musl_term_start musl_term_stop musl_tty_keys musl_wait_for_input vim_snprintf))
(define (host_alloc ed a0) ((vector-ref (ed-glue ed) 0) ed a0))
(define (host_exit ed a0) ((vector-ref (ed-glue ed) 1) ed a0))
(define (host_message ed a0 a1 a2) ((vector-ref (ed-glue ed) 2) ed a0 a1 a2))
(define (host_raise ed a0) ((vector-ref (ed-glue ed) 3) ed a0))
(define (host_time ed) ((vector-ref (ed-glue ed) 4) ed))
(define (host_write ed a0 a1) ((vector-ref (ed-glue ed) 5) ed a0 a1))
(define (musl_delay ed a0 a1) ((vector-ref (ed-glue ed) 6) ed a0 a1))
(define (musl_get_winsize ed a0 a1) ((vector-ref (ed-glue ed) 7) ed a0 a1))
(define (musl_host_init ed) ((vector-ref (ed-glue ed) 8) ed))
(define (musl_now_ms ed) ((vector-ref (ed-glue ed) 9) ed))
(define (musl_read_input ed a0 a1) ((vector-ref (ed-glue ed) 10) ed a0 a1))
(define (musl_suspend ed) ((vector-ref (ed-glue ed) 11) ed))
(define (musl_term_start ed) ((vector-ref (ed-glue ed) 12) ed))
(define (musl_term_stop ed) ((vector-ref (ed-glue ed) 13) ed))
(define (musl_tty_keys ed a0 a1 a2 a3 a4) ((vector-ref (ed-glue ed) 14) ed a0 a1 a2 a3 a4))
(define (musl_wait_for_input ed a0) ((vector-ref (ed-glue ed) 15) ed a0))
(define (vim_snprintf ed a0 a1 a2 args) ((vector-ref (ed-glue ed) 16) ed a0 a1 a2 args))

