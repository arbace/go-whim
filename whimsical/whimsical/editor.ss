              (when (and (not (fxzero? is_del)) (not (fxzero? (block_def.startspaces bdp))))
                (block_def.startspaces-set! bdp
                                            (fx- (block_def.start_char_vcols bdp)
                                                 (block_def.startspaces bdp))))
              (block_def.end_vcol-set! bdp (block_def.start_vcol bdp))
              (cond
                [(fx>? (block_def.end_vcol bdp) (oparg_T.end_vcol oap))
