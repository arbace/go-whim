           [adj_cursor (and (fx>? (win_T.w_cursor.col curwin) 0)
                            (fx=? (gchar_cursor ed) NUL)
                            (fxzero? (fxand cur_ve_flags VE_ONEMORE))
                            (fxzero? (fxand cur_ve_flags VE_ALL))
                            (not (or (not (fxzero? restart_edit))
                                     (not (fxzero? (fxand State MODE_INSERT))))))])
      (cond
        [adj_cursor
         (dec_cursor ed)
         (when (fx=? cur_ve_flags VE_ALL)
           (getvcol ed curwin (win_T.w_cursor& curwin) &scol 0 &ecol 0)
           (win_T.w_cursor.coladd-set! curwin (fx+ (fx- ecol scol) 1)))
         (frame-pop! ed fr)]
        [else (frame-pop! ed fr)]))))

(define (do_join ed count insert_space save_undo use_formatoptions setmark)
  (let ([mem (ed-mem ed)])
    (define (loop2 curr curr_start spaces endcurr1 endcurr2 currsize sumsize t ret)
      (if (< t count)
          (let ([curr_start (ml_get ed (+ (win_T.w_cursor.lnum curwin) t))])
            (define (join16 curr)
              (define (join23 curr)
                (let* ([currsize (->i32 (musl_strlen ed curr))]
                       [sumsize (fx+ sumsize (fx+ currsize (ld-u8 (fx+ spaces t))))])
                  (define (join26 endcurr1 endcurr2)
                    (line_breakcheck ed)
                    (if (fxzero? got_int)
                        (loop2 curr curr_start spaces endcurr1 endcurr2 currsize sumsize (+ t 1)
                               ret)
                        #f))
                  (if (and insert_space (fx>? currsize 0))
                      (let* ([cend (fx+ curr currsize)]
                             [t1 (fx+ (utf_head_off ed curr (fx+ cend -1)) 1)]
                             [cend (fx+ cend (fx- 0 t1))]
                             [endcurr1 (utf_ptr2char ed cend)])
                        (if (fx>? cend curr)
                            (let ([t2 (fx+ (utf_head_off ed curr (fx+ cend -1)) 1)])
                              (join26 endcurr1 (utf_ptr2char ed (fx+ cend (fx- 0 t2)))))
                            (join26 endcurr1 NUL)))
                      (join26 NUL NUL))))
              (if (and insert_space (> t 0))
                  (let ([curr (skipwhite ed curr)])
                    (define (join21 endcurr1)
                      (when (and (not (fxzero? p_js))
                                 (or (fx=? endcurr1 (ch #\.))
                                     (and (fxzero? (vim_strchr ed p_cpo CPO_JOINSP))
                                          (or (fx=? endcurr1 (ch #\?)) (fx=? endcurr1 (ch #\!))))))
                        (st-u8! (fx+ spaces t) (->u8 (fx+ (ld-u8 (fx+ spaces t)) 1))))
                      (join23 curr))
                    (if (and (not (fx=? (ld-u8 curr) NUL))
                             (not (fx=? (ld-u8 curr) (ch #\x29)))
                             (not (fxzero? sumsize))
                             (not (fx=? endcurr1 TAB)))
                        (cond
                          [(fx=? endcurr1 (ch #\space)) (join21 endcurr2)]
                          [else
                           (st-u8! (fx+ spaces t) (->u8 (fx+ (ld-u8 (fx+ spaces t)) 1)))
                           (join21 endcurr1)])
                        (join23 curr)))
                  (join23 curr)))
            (cond
              [(and (zero? t) setmark (fxzero? (fxand (cmdmod_T.cmod_flags cmdmod) CMOD_LOCKMARKS)))
               (buf_T.b_op_start.lnum-set! (win_T.w_buffer curwin) (win_T.w_cursor.lnum curwin))
               (let ([r1 (win_T.w_buffer curwin)])
                 (buf_T.b_op_start.col-set! r1 (->i32 (musl_strlen ed curr_start)))
                 (join16 curr_start))]
              [else (join16 curr_start)]))
          (let* ([col (fx- (fx- sumsize currsize) (ld-u8 (fx+ spaces (- count 1))))]
                 [newp_len (->u64 (fx+ sumsize 1))]
                 [newp (alloc ed newp_len)]
                 [cend (fx+ newp sumsize)])
            (st-u8! cend 0)
            (loop4 curr curr_start cend newp newp_len spaces currsize sumsize (- count 1) col
                   ret))))
    (define (loop4 curr curr_start cend newp newp_len spaces currsize sumsize t col ret)
      (let ([cend (fx+ cend (fx- 0 currsize))])
        (define (join6 cend)
          (let ([spaces_removed (->i32 (- (fx- curr curr_start) (ld-u8 (fx+ spaces t))))])
            (mark_col_adjust ed (+ (win_T.w_cursor.lnum curwin) t) 0 (- t)
                             (- (fx- cend newp) spaces_removed) spaces_removed)
            (cond
              [(zero? t)
               (ml_replace_len ed (win_T.w_cursor.lnum curwin) newp (->i32 newp_len) #t #f)
               (when (and setmark (fxzero? (fxand (cmdmod_T.cmod_flags cmdmod) CMOD_LOCKMARKS)))
                 (buf_T.b_op_end.lnum-set! (win_T.w_buffer curwin) (win_T.w_cursor.lnum curwin))
                 (buf_T.b_op_end.col-set! (win_T.w_buffer curwin) sumsize))
               (changed_lines ed (win_T.w_cursor.lnum curwin) currsize
                              (+ (win_T.w_cursor.lnum curwin) 1) 0)
               (let* ([t (win_T.w_cursor.lnum curwin)] [r2 curwin])
                 (win_T.w_cursor.lnum-set! r2 (+ (win_T.w_cursor.lnum r2) 1))
                 (del_lines ed (- count 1) #f)
                 (win_T.w_cursor.lnum-set! curwin t)
                 (let ([r3 curwin])
                   (win_T.w_cursor.col-set! r3
                                            (if (fxzero? (vim_strchr ed p_cpo CPO_JOINCOL))
                                                col
                                                currsize))
                   (check_cursor_col ed)
                   (win_T.w_cursor.coladd-set! curwin 0)
                   (win_T.w_set_curswant-set! curwin #t)
                   ret))]
              [else
               (let ([curr_start (ml_get ed (- (+ (win_T.w_cursor.lnum curwin) t) 1))])
                 (define (join9 curr)
                   (loop4 curr curr_start cend newp newp_len spaces (->i32 (musl_strlen ed curr))
                          sumsize (- t 1) col ret))
                 (if (and insert_space (> t 1))
                     (join9 (skipwhite ed curr_start))
                     (join9 curr_start)))])))
        (musl_memmove ed cend curr (->u64 currsize))
        (if (fx>? (ld-u8 (fx+ spaces t)) 0)
            (let ([cend (fx+ cend (fx- 0 (ld-u8 (fx+ spaces t))))])
              (musl_memset ed cend (ch #\space) (ld-u8 (fx+ spaces t)))
              (join6 cend))
            (join6 cend))))
    (if (and save_undo
             (not (u_save ed (- (win_T.w_cursor.lnum curwin) 1)
                          (+ (win_T.w_cursor.lnum curwin) count))))
        #f
        (loop2 0 0 (lalloc_clear ed (->u64 count) #t) NUL NUL 0 0 0 #t))))

(define (block_prep ed oap bdp lnum is_del)
