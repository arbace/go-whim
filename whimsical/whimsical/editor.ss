        (join14 did_isk))
      (if (or should_copy (not (fxzero? (fxand flags BCO_ALWAYS))))
          (let ([dont_do_help (or (and (not (fxzero? (fxand flags BCO_NOHELP))) (buf_T.b_help buf))
                                  (buf_T.b_p_initialized buf))])
            (define (join6 save_p_isk)
              (if (buf_T.b_p_initialized buf)
