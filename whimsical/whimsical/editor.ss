    (define (join8 prev_oap)
      (cond
        [(fxzero? got_int) (join12 prev_oap)]
        [(not quit_more) (vgetc ed) (join11 prev_oap)]
        [else (join11 prev_oap)]))
    (define (join11 prev_oap)
      (set! got_int 0)
      (join12 prev_oap))
    (define (join12 prev_oap)
      (set! msg_scroll 0)
      (set! quit_more #f)
      (cond
        [skip_redraw (set! skip_redraw #f) (setcursor ed) (cursor_on ed) (join26 prev_oap)]
        [(or do_redraw (stuff_empty ed))
         (may_trigger_deferred_events ed)
         (may_trigger_safestate ed (and (not (op_pending ed)) (fx=? restart_edit 0)))
         (update_topline ed)
         (validate_cursor ed)
         (cond
           [VIsual_active (update_curbuf ed 20) (join20 prev_oap)]
           [(not (fxzero? must_redraw)) (update_screen ed 0) (join20 prev_oap)]
           [(or (or (not (fxzero? redraw_cmdline)) clear_cmdline) redraw_mode) (showmode ed) (join20 prev_oap)]
           [else (join20 prev_oap)])]
        [else (join26 prev_oap)]))
    (define (join20 prev_oap)
      (redraw_statuslines ed)
      (if (not (fx=? keep_msg 0))
          (let ([p (vim_strsave ed keep_msg)])
            (set! msg_hist_off #t)
            (msg_attr ed p keep_msg_attr)
            (set! msg_hist_off #f)
            (join22 prev_oap))
          (join22 prev_oap)))
    (define (join22 prev_oap)
      (cond
        [need_fileinfo (fileinfo ed 0 #t #f) (set! need_fileinfo #f) (join24 prev_oap)]
        [else (join24 prev_oap)]))
    (define (join24 prev_oap)
      (set! emsg_on_display #f)
      (set! did_emsg 0)
      (set! msg_didany #f)
      (may_clear_sb_text ed)
      (showruler ed #f)
      (setcursor ed)
      (cursor_on ed)
      (set! do_redraw #f)
      (may_make_initial_scroll_size_snapshot ed)
      (join26 prev_oap))
    (define (join26 prev_oap)
      (may_send_t_RK ed)
      (update_curswant ed)
      (normal_cmd ed oa #t)
      (loop1 prev_oap))
    (let ([prev_oap current_oap])
      (set! current_oap oa)
      (clear_oparg ed oa)
      (loop1 prev_oap))))

(define (getout ed exitval)
  (let* ([mem (ed-mem ed)] [fr (frame-push! ed 32)])
    (define-c-local bufref &bufref agg 0)
    (define-c-local bufref_2 &bufref_2 agg 16)
    (define (join5)
      (cond
        [(not (fx=? (buf_T.b_ml.ml_root curbuf) 0)) (set_bufref ed bufref_2 curbuf) (join7)]
        [else (join7)]))
    (define (join7)
      (cond
        [(not (fxzero? did_emsg)) (set! no_wait_return 0) (wait_return ed 0) (join9)]
        [else (join9)]))
    (define (join9)
      (windgoto ed (i32- (->i32 Rows) 1) 0)
      (term_disable_dec ed)
      (mch_exit ed exitval)
      (frame-pop! ed fr))
    (set! exiting #t)
    (windgoto ed (i32- (->i32 Rows) 1) 0)
    (if (fx<=? v_dying 1)
        (if (and (not (fx=? (win_T.w_buffer curwin) 0)) (buf_valid ed (win_T.w_buffer curwin)))
            (let ([buf (win_T.w_buffer curwin)])
              (cond
                [(not (= (buf_T.b_changedtick buf) -1))
                 (set_bufref ed bufref buf)
                 (cond
                   [(bufref_valid ed bufref) (buf_T.b_changedtick-set! buf -1) (join5)]
                   [else (join5)])]
                [else (join5)]))
            (join5))
        (join7))))

(define (command_line_scan ed parmp)
  (let ([mem (ed-mem ed)])
    (define (loop1 argc argv argv_idx)
      (when (fx>? argc 0)
        (cond
          [(fx=? (ld-s8 (ld-ptr argv)) 43)
           (cond
             [(fx>=? (mparm_T.n_commands parmp) 10) (mainerr ed 1 0) (join7 argc argv)]
             [else (join7 argc argv)])]
          [else (mainerr ed 0 (ld-ptr argv)) (join10 argc argv argv_idx)])))
    (define (join7 argc argv)
      (if (fx=? (ld-s8 (fx+ (ld-ptr argv) 1)) 0)
          (let ([t1 (mparm_T.n_commands parmp)])
            (mparm_T.n_commands-set! parmp (i32+ (mparm_T.n_commands parmp) 1))
            (st-ptr! (fx+ (mparm_T.commands& parmp) (fx* t1 8)) (c-str 167401 "$"))
            (join10 argc argv -1))
          (let ([t2 (mparm_T.n_commands parmp)])
            (mparm_T.n_commands-set! parmp (i32+ (mparm_T.n_commands parmp) 1))
            (st-ptr! (fx+ (mparm_T.commands& parmp) (fx* t2 8)) (fx+ (ld-ptr argv) 1))
            (join10 argc argv -1))))
    (define (join10 argc argv argv_idx)
      (if (or (fx<=? argv_idx 0) (fx=? (ld-s8 (fx+ (ld-ptr argv) argv_idx)) 0))
          (loop1 (i32- argc 1) (fx+ argv 8) 1)
          (loop1 argc argv argv_idx)))
    (let ([argc (mparm_T.argc parmp)])
      (loop1 (i32- argc 1) (fx+ (mparm_T.argv parmp) 8) 1))))

(define (create_windows ed parmp)
  (let ([mem (ed-mem ed)])
    (define (join2)
      (ui_breakcheck ed)
      (cond
        [(not (fxzero? got_int)) (vgetc ed) (join4)]
        [else (join4)]))
    (define (join4)
      (set! curbuf (win_T.w_buffer curwin)))
    (set! curbuf (win_T.w_buffer curwin))
    (cond
      [(fx=? (buf_T.b_ml.ml_root curbuf) 0) (open_buffer ed) (join2)]
      [else (join2)])))

(define (exe_commands ed parmp)
  (let ([mem (ed-mem ed)])
    (define (join2)
      (estack_push ed 6 (c-str 167403 "command line") 0)
      (let loop3 ([i 0])
        (cond
          [(fx<? i (mparm_T.n_commands parmp))
           (do_cmdline_cmd ed (ld-ptr (fx+ (mparm_T.commands& parmp) (fx* i 8))))
           (loop3 (i32+ i 1))]
          [else
           (estack_pop ed)
           (cond
             [(= (win_T.w_cursor.lnum curwin) 0) (win_T.w_cursor.lnum-set! curwin 1) (join6)]
             [else (join6)])])))
    (define (join6)
      (set! msg_scroll 0))
    (set! msg_scroll 1)
    (cond
      [(<= (win_T.w_cursor.lnum curwin) 1) (win_T.w_cursor.lnum-set! curwin 0) (join2)]
      [else (join2)])))

(define (mainerr ed n str)
  (let* ([mem (ed-mem ed)] [fr (frame-push! ed 1024)])
    (define-c-local buf &buf agg 0)
    (define (join3)
      (host_message ed buf -1 1)
      (mch_exit ed 1)
      (frame-pop! ed fr))
    (init_longVersion ed)
    (cond
      [(not (fx=? str 0))
       (vim_snprintf ed buf 1024 (c-str 167416 "%s\n%s: \"%s\"") (list longVersion (ld-ptr (fx+ main_errors (fx* n 8))) str))
       (join3)]
      [else
       (vim_snprintf ed buf 1024 (c-str 167428 "%s\n%s") (list longVersion (ld-ptr (fx+ main_errors (fx* n 8)))))
       (join3)])))

(define (vim_main ed argc argv)
  (let ([mem (ed-mem ed)])
    (define (join2)
      (ui_get_shellsize ed)
      (win_init_size ed)
      (set! cmdline_row (->i32 (i64- Rows p_ch)))
      (set! cmdline_col_off 0)
      (set! cmdline_width (->i32 Columns))
      (set! msg_row cmdline_row)
      (set! msg_col 0)
      (screenalloc ed #f)
      (set_init_2 ed)
      (set! msg_scroll 1)
      (set! no_wait_return 1)
      (init_mappings ed)
      (init_highlight ed #t #f)
      (vim_main2 ed))
    (musl_memset ed params 0 112)
    (mparm_T.argc-set! params argc)
    (mparm_T.argv-set! params argv)
    (mparm_T.want_full_screen-set! params #t)
    (common_init_1 ed)
    (common_init_2 ed params)
    (command_line_scan ed params)
    (set! RedrawingDisabled (i32+ RedrawingDisabled 1))
    (mch_init ed)
    (cond
      [(mparm_T.want_full_screen params) (termcapinit ed) (screen_start ed) (join2)]
      [else (join2)])))

